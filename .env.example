# Copy these names into the backend process environment for deployment.
# Do not commit real values. The Windows one-click local path is 配置AI.cmd,
# which stores the API key with current-user DPAPI encryption.
APP_RUNTIME_DATABASE_PATH=/data/runtime-sessions.sqlite3
APP_FRONTEND_DIST_PATH=/app/frontend/dist
APP_MAX_REQUEST_BODY_BYTES=2097152
PORT=8000

AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=8
